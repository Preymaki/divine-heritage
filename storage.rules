rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Gallery images — public read, authenticated write only
    match /gallery/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // All other paths — deny writes by default
    match /{allPaths=**} {
      allow read: if true;
      allow write: if false;
    }
  }
}

# ─────────────────────────────────────────────────────────────────────────────
# Firebase Configuration
# Copy this file to .env.local and fill in your Firebase project values.
# Never commit .env.local to version control.
# ─────────────────────────────────────────────────────────────────────────────

VITE_FIREBASE_API_KEY=your-api-key-here
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your-messaging-sender-id
VITE_FIREBASE_APP_ID=your-app-id

# ─────────────────────────────────────────────────────────────────────────────
# Admin Access Control
# Comma-separated list of email addresses allowed to access the CMS/admin area.
# These emails are matched against the Magic Link sign-in address.
# ─────────────────────────────────────────────────────────────────────────────

VITE_ADMIN_EMAIL_WHITELIST=admin@example.com

# ─────────────────────────────────────────────────────────────────────────────
# App URL (used as the Magic Link redirect target)
# Set to your deployed domain in production; use http://localhost:5173 locally.
# ─────────────────────────────────────────────────────────────────────────────

VITE_APP_URL=http://localhost:5173

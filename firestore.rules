rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Admin authorisation helper ────────────────────────────────────────────
    //
    // Returns true only when ALL of the following are satisfied:
    //   1. The request carries a valid Firebase Auth token (user is signed in).
    //   2. The token's email address is verified by Firebase Auth.
    // Returns true only when ALL of the following are satisfied:
    //   1. The request carries a valid Firebase Auth token (user is signed in).
    //   2. The token's email address is verified by Firebase Auth.
    //   3. The email matches an authorised administrator:
    //      - Matches the verified admin email whitelist (vmacfoy3@gmail.com, divineheritagechildcare@gmail.com)
    //      - OR matches the email stored in settings/admin (if the document exists)
    //
    // Checking exists() before get() prevents runtime rule evaluation failures
    // when settings/admin has not yet been seeded.
    function isAdmin() {
      return request.auth != null
          && request.auth.token.email_verified == true
          && (
            request.auth.token.email.lower() in [
              'vmacfoy3@gmail.com',
              'divineheritagechildcare@gmail.com'
            ]
            || (
              exists(/databases/$(database)/documents/settings/admin)
              && request.auth.token.email.lower() == get(/databases/$(database)/documents/settings/admin).data.email.lower()
            )
          );
    }

    // ── Gallery collection ───────────────────────────────────────────────────
    // Public read (used by the public /gallery page).
    // Write operations restricted to the authorised admin only.
    match /gallery/{docId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // ── Settings collection ──────────────────────────────────────────────────
    // Public read (hero, contact, about are displayed on the public website).
    // Write operations restricted to the authorised admin only.
    match /settings/{docId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // ── Enquiries collection ─────────────────────────────────────────────────
    // Anyone can create (public contact form — no auth required).
    // Read, update, and delete restricted to the authorised admin only.
    match /enquiries/{docId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    // ── Policies collection ──────────────────────────────────────────────────
    // Public read (policy content is displayed on the public /policies page).
    // Write operations restricted to the authorised admin only.
    match /policies/{docId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // ── Applications collection ──────────────────────────────────────────────
    // Anyone can create (public online application submission).
    // Read, update, and delete are strictly restricted to the authorised admin only.
    // Unauthenticated/public users can never read or query application records.
    match /applications/{docId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    // ── Mail collection (Firebase Trigger Email extension) ───────────────────
    // Public create (allows application notifications to be queued).
    // Read, update, and delete restricted to the authorised admin only.
    match /mail/{docId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    // ── Default deny — all other collections ────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

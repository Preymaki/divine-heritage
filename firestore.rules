rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Gallery collection ───────────────────────────────────────────────────
    // Public read (used by the public /gallery page).
    // All write operations require the user to be authenticated.
    match /gallery/{docId} {
      allow read: if true;
      allow create, update, delete: if request.auth != null;
    }

    // ── Settings collection ──────────────────────────────────────────────────
    // Public read (hero, contact, about are displayed on the public website).
    // All write operations require the user to be authenticated.
    match /settings/{docId} {
      allow read: if true;
      allow create, update, delete: if request.auth != null;
    }

    // ── Enquiries collection ─────────────────────────────────────────────────
    // Anyone can create (public contact form — no auth required).
    // Only authenticated admin users can read, update, or delete.
    match /enquiries/{docId} {
      allow create: if true;
      allow read, update, delete: if request.auth != null;
    }

    // ── Default deny — all other collections ────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
